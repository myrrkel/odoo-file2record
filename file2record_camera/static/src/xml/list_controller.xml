<?xml version="1.0" encoding="UTF-8"?>
<templates>

    <t t-inherit="web.ListView" t-inherit-mode="extension" owl="1">
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="inside">
            <t t-call="file2record_camera.WebcamButton"/>
        </xpath>
    </t>

    <t t-inherit="web.KanbanView.Buttons" t-inherit-mode="extension" owl="1">
        <xpath expr="//div[hasclass('file2record-btn-group')]" position="inside">
            <t t-call="file2record_camera.WebcamButton"/>
        </xpath>
    </t>

</templates>
